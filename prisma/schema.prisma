generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ইউজারের রোল এবং অর্ডারের স্ট্যাটাস
enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  MANUAL_BKASH
  MANUAL_NAGAD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingZone {
  INSIDE_CITY
  OUTSIDE_CITY
}

enum NotificationType {
  ORDER_UPDATE
  SHOP_APPROVED
  PAYOUT_UPDATE
  LOW_STOCK
  SYSTEM
}

// ১. ইউজার টেবিল
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop          Shop?             // একজন ইউজারের একটিই শপ থাকতে পারবে
  cart          Cart?             // একজন ইউজারের একটিই কার্ট থাকবে
  wishlist      Wishlist?         // ইউজারের উইশলিস্ট
  orders        Order[]
  reviews       Review[]          // ইউজারের দেওয়া রিভিউগুলো
  addresses     Address[]         // সেভ করা ডেলিভারি অ্যাড্রেস
  notifications Notification[]    // ইন-অ্যাপ নোটিফিকেশন
  questions     ProductQuestion[] // প্রোডাক্ট নিয়ে করা প্রশ্ন
}

// ২. শপ / ভেন্ডর টেবিল
model Shop {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  logo           String?
  isApproved     Boolean   @default(false) // অ্যাডমিন অ্যাপ্রুভ করলে true হবে
  commissionRate Float     @default(10.0)  // প্ল্যাটফর্ম কমিশন (%)
  walletBalance  Float     @default(0)     // তোলার যোগ্য ব্যালেন্স
  totalEarned    Float     @default(0)     // সর্বমোট আয়
  ownerId        String    @unique
  owner          User      @relation(fields: [ownerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products       Product[]
  orderItems     OrderItem[]     // ভেন্ডর শুধু তার নিজের অর্ডার আইটেম দেখবে
  coupons        Coupon[]        // ভেন্ডরের তৈরি কুপন
  payoutRequests PayoutRequest[] // পে-আউট রিকোয়েস্ট
}

// ৩. ক্যাটাগরি টেবিল
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
}

// ৪. প্রোডাক্ট টেবিল
model Product {
  id            String         @id @default(uuid())
  name          String
  description   String
  price         Float
  stock         Int            @default(0)
  images        String[]       // একাধিক ছবির URL রাখার জন্য অ্যারে
  averageRating Float          @default(0)
  reviewCount   Int            @default(0)
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id])
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  questions     ProductQuestion[]
}

// ৫. কার্ট ও কার্ট আইটেম
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId]) // একই প্রোডাক্ট কার্টে দুইবার আলাদা রো না হয়ে quantity বাড়বে
}

// ৬. অর্ডার ও মাল্টি-ভেন্ডর অর্ডার আইটেম
model Order {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  totalAmount   Float
  shippingFee   Float         @default(0)
  shippingZone  ShippingZone  @default(INSIDE_CITY)
  address       String
  phone         String
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())

  items         OrderItem[]
}

model OrderItem {
  id               String      @id @default(uuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  shopId           String      // কোন ভেন্ডরের প্রোডাক্ট তা আলাদা করার জন্য
  shop             Shop        @relation(fields: [shopId], references: [id])
  quantity         Int
  price            Float       // অর্ডারের সময় প্রোডাক্টের দাম কত ছিল তা সেভ থাকবে
  commissionAmount Float       @default(0) // প্ল্যাটফর্ম কমিশন
  vendorEarning    Float       @default(0) // ভেন্ডরের নিট আয়
  isSettled        Boolean     @default(false) // ভেন্ডর ওয়ালেটে টাকা জমা হয়েছে কিনা
  status           OrderStatus @default(PENDING) // প্রত্যেক ভেন্ডর তার নিজের আইটেমের স্ট্যাটাস পাল্টাবে
}

// ৭. রিভিউ ও রেটিং টেবিল
model Review {
  id        String   @id @default(uuid())
  rating    Int      // ১ থেকে ৫ স্টার
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId]) // একজন কাস্টমার একটি প্রোডাক্টে সর্বোচ্চ একটি রিভিউ দিতে পারবে
}

// ৮. উইশলিস্ট টেবিল
model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ৯. কুপন টেবিল
model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  maxDiscount   Float?
  expiryDate    DateTime
  isActive      Boolean      @default(true)
  shopId        String?      // null হলে অ্যাডমিন/প্ল্যাটফর্ম-ওয়াইড, অন্যথায় ভেন্ডর-স্পেসিফিক
  shop          Shop?        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
}

// ১০. ভেন্ডর পে-আউট রিকোয়েস্ট টেবিল
model PayoutRequest {
  id             String       @id @default(uuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMethod  String       // যেমন: BKASH, NAGAD, BANK
  accountDetails String       // মোবাইল নম্বর বা ব্যাংক একাউন্ট তথ্য
  status         PayoutStatus @default(PENDING)
  transactionRef String?      // অ্যাডমিন টাকা পাঠানোর পর রেফারেন্স আইডি
  adminNote      String?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
}

// ১১. কাস্টমার অ্যাড্রেস বুক টেবিল
model Address {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String       @default("Home") // যেমন: Home, Office
  fullName  String
  phone     String
  street    String
  city      String
  zone      ShippingZone @default(INSIDE_CITY)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ১২. ইন-অ্যাপ নোটিফিকেশন টেবিল
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

// ১৩. প্রোডাক্ট Q&A (প্রশ্ন ও উত্তর)
model ProductQuestion {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
}